<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimModSummoner</AssemblyName>
    <Version>0.3.0-dev</Version>
    <OutputPath>../Mod/$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == '' and '$(RimWorldVersion)' == '1.6'">D:/STEAM/steamapps/common/RimWorld/RimWorldWin64_Data/Managed</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and '$(RimWorldVersion)' == '1.7'">D:/STEAM/steamapps/common/RimWorld</GameDir>
    <Workshop Condition="'$(Workshop)' == ''">D:/STEAM/steamapps/workshop/content/294100</Workshop>
    <HarmonyDll Condition="'$(HarmonyDll)' == '' and Exists('$(Workshop)/2009463077/$(RimWorldVersion)/Assemblies/0Harmony.dll')">$(Workshop)/2009463077/$(RimWorldVersion)/Assemblies/0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(Workshop)/2009463077/Current/Assemblies/0Harmony.dll</HarmonyDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="'$(RimWorldVersion)' == '1.6'"><HintPath>$(GameDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="'$(RimWorldVersion)' == '1.6'"><HintPath>$(GameDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="'$(RimWorldVersion)' == '1.6'"><HintPath>$(GameDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs" Condition="'$(RimWorldVersion)' == '1.7'"><HintPath>$(GameDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateRimWorldVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="Supported build versions are 1.6 and 1.7." />
  </Target>
</Project>
