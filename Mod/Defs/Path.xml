<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <VanillaPsycastsExpanded.PsycasterPathDef>
    <defName>RMS_Summoner</defName><label>召唤师</label>
    <description>与真实的生物建立灵魂契约，守护彼此的生命。</description>
    <tooltip>灵狼契约 v0.1.2：学习灵魂契约后，将在一至两天内定位被部落守卫囚禁的大型灵狼。救援、照料、战斗和羁绊让它成长。死亡不可逆转。</tooltip>
    <lockedReason>v0.1仅玩家阵营可学习召唤师路径。</lockedReason><ignoreLockRestrictionsForNeurotrainers>false</ignoreLockRestrictionsForNeurotrainers>
    <tab>Psycasts</tab><width>320</width><height>430</height><backgroundColor>(0.08,0.15,0.20,1)</backgroundColor>
  </VanillaPsycastsExpanded.PsycasterPathDef>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RMS_Contract</defName><label>灵魂契约</label>
    <description>学习后感应灵魂的呼唤。一至两天后，前往野外营地击败部落守卫，救下专属候选灵狼并与它建立契约；无候选时可对自己施法重新寻找。新契约带来两天虚弱。只能维持一只。</description>
    <iconPath>UI/Summoner/Contract</iconPath><abilityClass>RimMod.Summoner.Ability_Contract</abilityClass>
    <castTime>120</castTime><cooldownTime>3600</cooldownTime><range>12</range><targetMode>Pawn</targetMode><showUndrafted>true</showUndrafted>
    <targetingParameters><canTargetSelf>true</canTargetSelf><canTargetAnimals>true</canTargetAnimals><canTargetHumans>true</canTargetHumans><canTargetMechs>false</canTargetMechs></targetingParameters>
    <modExtensions><li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>RMS_Summoner</path><level>1</level><order>1</order><psyfocusCost>0.05</psyfocusCost><entropyGain>10</entropyGain></li></modExtensions>
  </VEF.Abilities.AbilityDef>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RMS_Call</defName><label>灵魂呼唤</label>
    <description>把同地图的契约兽移动到身边。保持同一个体与全部伤病，不能复活、跨地图或凭空补充。</description>
    <iconPath>UI/Summoner/Call</iconPath><abilityClass>RimMod.Summoner.Ability_Call</abilityClass>
    <castTime>60</castTime><cooldownTime>1800</cooldownTime><targetMode>Self</targetMode><showUndrafted>true</showUndrafted>
    <modExtensions><li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>RMS_Summoner</path><level>2</level><order>1</order><psyfocusCost>0.03</psyfocusCost><entropyGain>8</entropyGain><prerequisites><li>RMS_Contract</li></prerequisites></li></modExtensions>
  </VEF.Abilities.AbilityDef>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>RMS_Link</defName><label>灵魂链接</label>
    <description>切换链接。同地图30格内，主人所受外部攻击的20%转为灵狼的灵魂伤口，可致死。离开范围暂停生效。关闭不消耗专注。</description>
    <iconPath>UI/Summoner/Link</iconPath><abilityClass>RimMod.Summoner.Ability_Link</abilityClass>
    <castTime>30</castTime><cooldownTime>300</cooldownTime><targetMode>Self</targetMode><showUndrafted>true</showUndrafted>
    <modExtensions><li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>RMS_Summoner</path><level>3</level><order>1</order><psyfocusCost>0.02</psyfocusCost><entropyGain>5</entropyGain><prerequisites><li>RMS_Call</li></prerequisites></li></modExtensions>
  </VEF.Abilities.AbilityDef>
</Defs>
